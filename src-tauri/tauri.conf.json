{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOIRE",
  "version": "0.3.0",
  "identifier": "com.toire.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TOIRE - ゲーマー特化軽量化ツール",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1200,
        "minHeight": 700,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "headerImage": "../dist/Untitled.png",
        "sidebarImage": "../dist/Untitled.png",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wasaomen/FARST/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNDI1RjAxRkU0M0I1NkMKUldSc3RVUCtBVjlDcXpvUjZ4aktlZDQ5NUNWVnNyK2xNclZiNERNNENTTGtVNWwydjdkOVBUci8K"
    }
  }
}
