{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zero",
  "version": "4.0.0",
  "identifier": "com.zero.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zero - System Optimizer",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 660,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "headerImage": "../dist/Untitled.png",
        "sidebarImage": "../dist/Untitled.png",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wasaomen/FARST/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMkU4QTkwQzU3Mjk3NTMKUldSVGwzTEZrSW91VTJBV3dIK2d2L1NMRTByTXBTWEpxK3FWTHkzRGVINGwxRDdWaVNwbG5MZFkK"
    }
  }
}
